# ─── Todo esto es OPCIONAL. Sin .env, Blink funciona completo con el banco local. ───

# Duración de la "hora Blink", en segundos. 90 para la demo en vivo.
ROUND_SECONDS=90

# URL pública: es lo que se codifica en el QR del proyector.
# Si no la definís, el servidor detecta tu IP de red local y el QR funciona desde el celular.
# En producción (Railway) SÍ hay que definirla.
PUBLIC_URL=https://blink-production-ee8f.up.railway.app/

# Protege /presenter. Si se define, hay que abrir /presenter?key=loquesea
# PRESENTER_KEY=campanada

# ─── Gemini (opcional) ───────────────────────────────────────────────────────────
# Sin key, el auditor usa plantillas + números medidos: 0ms, $0, sin red.
# Con key, Gemini redacta la prosa. Los números y el IEC NUNCA los decide el modelo.
# GEMINI_API_KEY=

# Verificá el ID exacto con: npm run models
GEMINI_MODEL=gemini-3.8-flash

# Por debajo del límite del free tier (~10 RPM). No lo subas para el evento:
# el banco cubre todo lo que el rate limiter deje pasar.
GEMINI_RPM=8
GEMINI_DAILY_CAP=1200

# Si el modelo no contesta en este tiempo, gana la plantilla.
LLM_TIMEOUT_MS=1200

# Descomentar para ver por qué falla una llamada a Gemini.
# LLM_DEBUG=1
